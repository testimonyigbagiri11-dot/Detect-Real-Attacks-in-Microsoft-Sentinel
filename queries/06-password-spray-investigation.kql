// Investigate an external IP targeting multiple user accounts.
// One or a few password attempts across many usernames is consistent
// with a password-spray attack rather than brute force against one account.
MeridianLogs_CL
| where RawData has "198.51.100.23"
| extend Username = extract(@"for (?:invalid user )?([^ ]+) from", 1, RawData)
| extend Action = case(
    RawData has "Accepted password", "SUCCESS",
    RawData has "Failed password", "FAILED",
    "OTHER"
    )
| project EventTime_t, Username, Action, RawData
| order by EventTime_t asc