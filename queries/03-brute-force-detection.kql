// Detect source IPs generating more than five failed SSH logins
// within a 10-minute window.
// 
// This query was used in a Microsoft Sentinel scheduled analytics rule
// configured to run every five minutes over the previous hour.
MeridianLogs_CL
| where RawData has "Failed password"
| extend SourceIP = extract(@"from ([0-9.]+)", 1, RawData)
| where isnotempty(SourceIP)
| summarize FailedAttempts = count()
    by SourceIP, bin(TimeGenerated, 10m)
| where FailedAttempts > 5